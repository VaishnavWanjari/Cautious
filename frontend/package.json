{
  "name": "commissioning-scheduler-pro",
  "version": "0.1.0",
  "description": "EPC pre-commissioning & commissioning planning desktop app: backward scheduling, critical path, editable visual logic networks, Gantt and reporting.",
  "author": "Commissioning Scheduler Pro",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build && electron .",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:web": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "reactflow": "^11.11.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.commissioning.scheduler",
    "productName": "Commissioning Scheduler Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!.venv", "!data", "!__pycache__"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Commissioning-Scheduler-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Commissioning-Scheduler-Pro-Portable-${version}.${ext}"
    }
  }
}
